#!/usr/bin/env python3
import argparse
import json
import re
import time
import uuid
from pathlib import Path

UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
FIELDS = {"from", "to", "reply-to", "after", "content"}
REQUIRED = {"from", "after", "content"}


def is_uuid(value):
    if not isinstance(value, str) or not UUID_RE.fullmatch(value):
        return False
    return str(uuid.UUID(value)) == value


def valid_message(message):
    if not isinstance(message, dict):
        return False
    if not REQUIRED <= message.keys() <= FIELDS:
        return False
    if not is_uuid(message["from"]) or not isinstance(message["content"], str):
        return False
    if "to" in message and not is_uuid(message["to"]):
        return False
    if "reply-to" in message and not is_uuid(message["reply-to"]):
        return False
    after = message["after"]
    return (
        isinstance(after, list)
        and all(is_uuid(item) for item in after)
        and len(after) == len(set(after))
    )


class Listener:
    def __init__(self, directory, identity):
        self.directory = directory
        self.identity = identity
        self.messages = {}
        self.resolved = set()
        self.rejected = set()
        self.attempted = {}
        self.group = []

    def load(self):
        for path in self.directory.glob("*.json"):
            message_id = path.stem
            if message_id in self.messages or not UUID_RE.fullmatch(message_id):
                continue
            try:
                stat = path.stat()
                fingerprint = (stat.st_mtime_ns, stat.st_size)
                if self.attempted.get(message_id) == fingerprint:
                    continue
                self.attempted[message_id] = fingerprint
                message = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, UnicodeDecodeError, json.JSONDecodeError):
                continue
            if valid_message(message):
                self.messages[message_id] = message

    def covers_reply(self, message):
        target = message.get("reply-to")
        if not target:
            return True
        pending = list(message["after"])
        seen = set()
        while pending:
            message_id = pending.pop()
            if message_id == target:
                return True
            if message_id in seen:
                continue
            seen.add(message_id)
            pending.extend(self.messages[message_id]["after"])
        return False

    def resolve(self, report_invalid=True):
        ordered = []
        while True:
            ready = sorted(
                message_id
                for message_id, message in self.messages.items()
                if message_id not in self.resolved | self.rejected
                and all(item in self.resolved for item in message["after"])
            )
            if not ready:
                return ordered
            for message_id in ready:
                message = self.messages[message_id]
                if not self.covers_reply(message):
                    self.rejected.add(message_id)
                    if report_invalid:
                        print(
                            f"[invalid {message_id}.json] reply-to is not covered by after",
                            flush=True,
                        )
                    continue
                self.resolved.add(message_id)
                ordered.append(message_id)

    def ancestors(self, message_id):
        pending = list(self.messages[message_id]["after"])
        ancestors = set()
        while pending:
            predecessor = pending.pop()
            if predecessor in ancestors:
                continue
            ancestors.add(predecessor)
            pending.extend(self.messages[predecessor]["after"])
        return ancestors

    def seed(self):
        self.load()
        self.resolve(report_invalid=False)

    def scan(self):
        self.load()
        for message_id in self.resolve():
            message = self.messages[message_id]
            if message.get("to") == self.identity:
                ancestors = self.ancestors(message_id)
                context = [item for item in self.group if item in ancestors]
                for item in context:
                    print_message("context", item, self.messages[item])
                self.group = [item for item in self.group if item not in ancestors]
                print_message("direct", message_id, message)
            else:
                self.group.append(message_id)

    def flush_group(self):
        if not self.group:
            return
        print(
            f"[group digest: {len(self.group)} causally ready "
            f"message{'s' if len(self.group) != 1 else ''}]",
            flush=True,
        )
        for message_id in self.group:
            print_message("group", message_id, self.messages[message_id])
        self.group.clear()


def print_message(kind, message_id, message):
    print(
        f"[{kind} {message_id}.json] from={message['from']} "
        f"to={message.get('to', '<all>')} "
        f"reply-to={message.get('reply-to', '-')}",
        flush=True,
    )
    print(message["content"], flush=True)


def positive_seconds(value):
    seconds = float(value)
    if seconds <= 0:
        raise argparse.ArgumentTypeError("must be greater than zero")
    return seconds


def main():
    default_directory = Path(__file__).resolve().parent / "messages"
    parser = argparse.ArgumentParser(
        description="Listen for direct pool messages immediately and batch the rest"
    )
    parser.add_argument("identity", help="this listener's participant UUID")
    parser.add_argument(
        "directory", nargs="?", type=Path, default=default_directory,
        help="message directory",
    )
    parser.add_argument(
        "--poll-seconds", type=positive_seconds, default=1.0,
        help="direct-message scan interval (default: 1)",
    )
    parser.add_argument(
        "--group-seconds", type=positive_seconds, default=300.0,
        help="group digest interval (default: 300)",
    )
    args = parser.parse_args()
    if not is_uuid(args.identity):
        parser.error("identity must be a lowercase canonical UUID")
    args.directory.mkdir(parents=True, exist_ok=True)

    listener = Listener(args.directory, args.identity)
    listener.seed()
    print(
        f"Listening as {args.identity}: direct every {args.poll_seconds:g}s; "
        f"group digest every {args.group_seconds:g}s",
        flush=True,
    )
    next_group = time.monotonic() + args.group_seconds
    while True:
        listener.scan()
        now = time.monotonic()
        if now >= next_group:
            listener.flush_group()
            next_group = now + args.group_seconds
        time.sleep(args.poll_seconds)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
